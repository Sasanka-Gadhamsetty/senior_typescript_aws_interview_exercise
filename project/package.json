{
  "name": "senior-typescript-aws-interview-exercise",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory listing and reservation endpoint handlers for the home-grown API Gateway -> Cognito -> Lambda framework.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "dev": "node --env-file-if-exists=.env -r ts-node/register src/server.ts",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
